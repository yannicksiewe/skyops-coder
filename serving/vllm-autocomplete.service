[Unit]
Description=vLLM autocomplete (FIM) model (GPU 1)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
EnvironmentFile=/etc/vllm.env
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
# no CUDA toolkit on the VM: skip FlashInfer's JIT-compiled sampler (falls back to the torch sampler)
Environment=VLLM_USE_FLASHINFER_SAMPLER=0
Environment=CUDA_VISIBLE_DEVICES=1
ExecStart=/home/ubuntu/vllm/.venv/bin/vllm serve ${FIM_MODEL} \
  --host 0.0.0.0 --port 8001 --api-key ${VLLM_API_KEY} \
  --served-model-name coder-fim \
  --dtype half --max-model-len 8192 --max-num-seqs 16 --gpu-memory-utilization 0.90
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
