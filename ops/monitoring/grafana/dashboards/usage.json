   "targets": [
    {
     "expr": "sort_desc(sum by (end_user) (increase(litellm_input_tokens_metric_total[7d]) + increase(litellm_output_tokens_metric_total[7d])))",
     "format": "table",
     "instant": true,
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true
      }
     }
    }
